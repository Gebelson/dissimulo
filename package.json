{
  "name": "dissimulo-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,WEB\" -c \"yellow,cyan\" \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "pnpm --filter @alibi/game-server dev",
    "dev:web": "pnpm --filter @alibi/web dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "pnpm --filter @alibi/game-server sim",
    "test:multiplayer": "pnpm --filter @alibi/game-server test:multiplayer"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
